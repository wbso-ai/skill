#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree is niet clean. Commit of stash eerst je wijzigingen." >&2
  exit 1
fi

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$current_branch" != "main" ]]; then
  echo "Releases worden alleen vanaf main gemaakt (huidige branch: $current_branch)." >&2
  exit 1
fi

git fetch --tags --quiet

manifests=(
  "packages/wbso/.claude-plugin/plugin.json"
  "packages/wbso/.codex-plugin/plugin.json"
)

for manifest in "${manifests[@]}"; do
  if [[ ! -f "$manifest" ]]; then
    echo "Manifest ontbreekt: $manifest" >&2
    exit 1
  fi
done

commit_count="$(git rev-list --count HEAD)"
new_minor=$((commit_count + 1))
new_version="1.${new_minor}"
tag="v${new_version}"

if git rev-parse "${tag}" >/dev/null 2>&1; then
  echo "Tag ${tag} bestaat al, er is niets te releasen." >&2
  exit 1
fi

for manifest in "${manifests[@]}"; do
  tmp="$(mktemp)"
  jq --arg v "${new_version}" '.version = $v' "${manifest}" > "${tmp}"
  mv "${tmp}" "${manifest}"
done

bin/sync-wbso-cli

git add "${manifests[@]}" packages/wbso/skills/*/scripts/wbso
git commit -m "Release ${tag}"
git tag -a "${tag}" -m "Release ${tag}"
git push origin main
git push origin "${tag}"

gh release create "${tag}" --title "${tag}" --generate-notes

echo "Released ${tag}"
