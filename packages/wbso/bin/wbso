#!/usr/bin/env bash
# wbso — thin CLI wrapper voor de WBSO.ai compliance API.
#
# Subcommands: signup, login, context, book, book-delete, evidence
# Config wordt geladen uit ~/.config/wbso/.env.local (optionele dev-override)
# en ~/.config/wbso/config (api key, email, base url).

set -euo pipefail

CONFIG_DIR="$HOME/.config/wbso"
CONFIG_FILE="$CONFIG_DIR/config"
ENV_LOCAL="$CONFIG_DIR/.env.local"
DEFAULT_BASE_URL="https://portal.wbso.ai"

load_env() {
  [ -f "$ENV_LOCAL" ] && source "$ENV_LOCAL"
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  WBSO_API_BASE_URL="${WBSO_API_BASE_URL:-$DEFAULT_BASE_URL}"
}

require_auth() {
  if [ -z "${WBSO_API_KEY:-}" ]; then
    echo "error: geen WBSO_API_KEY in $CONFIG_FILE. Run 'wbso signup' of 'wbso login' eerst." >&2
    exit 2
  fi
}

# Like require_auth but for context: output structured "not_logged_in"
# markdown instead of an error, so the skill can branch on the response.
not_logged_in_md() {
  cat <<'EOF'
<status>not_logged_in</status>

Niet ingelogd. Run `wbso signup` of `wbso login`.
EOF
}

write_config() {
  local email="$1"
  local api_key="$2"
  mkdir -p "$CONFIG_DIR"
  umask 077
  cat > "$CONFIG_FILE" <<EOF
WBSO_USER="$email"
WBSO_API_KEY="$api_key"
WBSO_API_BASE_URL="$WBSO_API_BASE_URL"
EOF
  chmod 600 "$CONFIG_FILE"
}

usage() {
  cat >&2 <<EOF
Usage: wbso <command> [options]

Commands:
  signup        Maak een nieuw WBSO.ai account aan
  login         Sla bestaande api-key + email op in config
  context       Haal compliance-context op (projects, time_entries, alerts, instructions)
  track-time    Registreer uren op een project
  untrack-time  Verwijder een urenregistratie
  evidence      Voeg onderbouwing toe
  whoami        Toon wie ingelogd is (of "not_logged_in")

Run 'wbso <command> --help' voor opties per command.
EOF
  exit 1
}

# Read --flag value pairs into named bash variables.
# Usage: parse_args "key1 key2 key3" "$@"
parse_args() {
  local allowed="$1"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        echo "Allowed flags: $allowed" >&2; exit 1 ;;
      --*=*)
        local key="${1#--}"; key="${key%%=*}"
        local val="${1#*=}"
        eval "ARG_${key//-/_}=\"\$val\""
        ;;
      --*)
        local key="${1#--}"
        shift
        eval "ARG_${key//-/_}=\"\$1\""
        ;;
      *)
        echo "error: onbekend argument '$1'" >&2; exit 2 ;;
    esac
    shift
  done
}

cmd_signup() {
  parse_args "first-name last-name email company-name" "$@"
  : "${ARG_first_name:?--first-name verplicht}"
  : "${ARG_last_name:?--last-name verplicht}"
  : "${ARG_email:?--email verplicht}"
  : "${ARG_company_name:?--company-name verplicht}"

  load_env

  local response
  response=$(curl -sS -X POST -H "Accept: application/json" \
    --data-urlencode "email=$ARG_email" \
    --data-urlencode "first_name=$ARG_first_name" \
    --data-urlencode "last_name=$ARG_last_name" \
    --data-urlencode "company_name=$ARG_company_name" \
    --data-urlencode "utm_source=claude_code" \
    --data-urlencode "utm_medium=skill" \
    "$WBSO_API_BASE_URL/signup")

  local api_key
  api_key=$(echo "$response" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("api_key",""))')

  if [ -z "$api_key" ]; then
    echo "$response"
    exit 1
  fi

  write_config "$ARG_email" "$api_key"
  echo "$response"
}

cmd_login() {
  parse_args "api-key" "$@"
  : "${ARG_api_key:?--api-key verplicht}"

  load_env
  WBSO_API_KEY="$ARG_api_key"

  local tmp
  tmp=$(mktemp)
  local status
  status=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $WBSO_API_KEY" \
    "$WBSO_API_BASE_URL/api/v1/compliance/context.md?date=$(date +%F)")

  if [ "$status" != "200" ]; then
    rm -f "$tmp"
    echo "error: api-key niet geldig (status $status)" >&2
    exit 1
  fi

  # Email en bedrijf staan in de respons als "**Gebruiker**: ..." en "**Bedrijf**: ..."
  local email company
  email=$(grep -m1 '^\*\*Gebruiker\*\*:' "$tmp" | sed 's/^\*\*Gebruiker\*\*: //')
  company=$(grep -m1 '^\*\*Bedrijf\*\*:' "$tmp" | sed 's/^\*\*Bedrijf\*\*: //')
  rm -f "$tmp"

  if [ -z "$email" ]; then
    echo "error: kon email niet bepalen uit context-respons" >&2
    exit 1
  fi

  write_config "$email" "$ARG_api_key"
  if [ -n "$company" ]; then
    echo "ok ($email · $company)"
  else
    echo "ok ($email)"
  fi
}

cmd_context() {
  parse_args "date user-email" "$@"
  load_env

  if [ -z "${WBSO_API_KEY:-}" ]; then
    not_logged_in_md
    return 0
  fi

  local date="${ARG_date:-$(date +%F)}"
  local extra=""
  [ -n "${ARG_user_email:-}" ] && extra="--data-urlencode user_email=$ARG_user_email"

  local tmp
  tmp=$(mktemp)
  local status
  # shellcheck disable=SC2086
  status=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -G -H "Authorization: Bearer $WBSO_API_KEY" \
    --data-urlencode "date=$date" \
    $extra \
    "$WBSO_API_BASE_URL/api/v1/compliance/context.md")

  if [ "$status" = "401" ] || [ "$status" = "403" ]; then
    rm -f "$tmp"
    not_logged_in_md
    return 0
  fi

  cat "$tmp"
  rm -f "$tmp"

  append_local_signals
}

append_local_signals() {
  append_git_commits_today
  append_claude_sessions_today
}

append_git_commits_today() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  local log
  log=$(git log --all --since=midnight --pretty=format:'## %h (%an) %aI%n%n%s%n%n%b' --stat=200 2>/dev/null)
  [ -z "$log" ] && return 0
  echo
  echo "<git_commits_today cwd=\"$(pwd)\">"
  echo "$log"
  echo "</git_commits_today>"
}

append_claude_sessions_today() {
  local slug="${PWD//\//-}"
  slug="${slug//./-}"
  local dir="$HOME/.claude/projects/$slug"
  [ -d "$dir" ] || return 0

  local today
  today="$(date +%F)"
  local files
  files=$(find "$dir" -maxdepth 1 -name '*.jsonl' -newermt "$today" 2>/dev/null)
  [ -z "$files" ] && return 0

  echo
  echo "<claude_user_prompts_today cwd=\"$(pwd)\">"
  echo "Alleen prompts die de gebruiker zelf naar Claude stuurde (geen"
  echo "assistant-antwoorden, geen tool-calls). Eén regel per prompt."
  echo "Gebruik dit als signaal voor waar de gebruiker vandaag mee"
  echo "bezig was."
  echo
  echo "$files" | while read -r f; do
    [ -f "$f" ] || continue
    python3 - "$f" <<'PY'
import json, sys

SKIP_PREFIXES = ("Base directory", "<command-message>", "<command-name>",
                 "<local-command-", "<system-reminder>")

def echo(text):
    text = text.strip()
    if not text or any(text.startswith(p) for p in SKIP_PREFIXES):
        return
    print("-", text.replace("\n", " "))

for line in open(sys.argv[1], errors="replace"):
    try:
        d = json.loads(line)
    except Exception:
        continue
    msg = d.get("message", {})
    if msg.get("role") != "user":
        continue
    content = msg.get("content")
    if isinstance(content, str):
        echo(content)
    elif isinstance(content, list):
        for c in content:
            if c.get("type") == "text":
                echo(c.get("text", ""))
PY
  done
  echo "</claude_user_prompts_today>"
}

cmd_track_time() {
  parse_args "project date duration user-email" "$@"
  : "${ARG_project:?--project verplicht}"
  : "${ARG_date:?--date verplicht}"
  : "${ARG_duration:?--duration verplicht}"

  load_env
  require_auth

  local body
  body=$(python3 -c '
import json, sys
entry = {"project": sys.argv[1], "date": sys.argv[2], "duration": float(sys.argv[3])}
if len(sys.argv) > 4 and sys.argv[4]:
    entry["user"] = sys.argv[4]
print(json.dumps({"time_entry": entry}))
' "$ARG_project" "$ARG_date" "$ARG_duration" "${ARG_user_email:-}")

  curl -sS -X POST "$WBSO_API_BASE_URL/api/v1/compliance/time_entries" \
    -H "Authorization: Bearer $WBSO_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$body"
}

cmd_whoami() {
  load_env

  if [ -z "${WBSO_API_KEY:-}" ]; then
    echo "not_logged_in"
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  local status
  status=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer $WBSO_API_KEY" \
    "$WBSO_API_BASE_URL/api/v1/compliance/context.md?date=$(date +%F)")

  if [ "$status" != "200" ]; then
    rm -f "$tmp"
    echo "not_logged_in"
    return 0
  fi

  python3 - "$tmp" <<'PY'
import re, sys

text = open(sys.argv[1]).read()
user = re.search(r"^\*\*Gebruiker\*\*:\s*(.+)$", text, re.M)
company = re.search(r"^\*\*Bedrijf\*\*:\s*(.+)$", text, re.M)

print((user.group(1).strip() if user else "(onbekend)") +
      (" · " + company.group(1).strip() if company else ""))

blocks = re.findall(r'<project [^>]*slug="([^"]+)"[^>]*>(.*?)</project>', text, re.S)
if blocks:
    print("Actieve projecten:")
    for slug, body in blocks:
        title_m = re.search(r"# Projecttitel\s*\n\s*(.+)", body)
        quota_m = re.search(r"# Aantal uren werknemers\s*\n\s*(\d+)", body)
        title = title_m.group(1).strip() if title_m else "(geen titel)"
        quota = quota_m.group(1).strip() if quota_m else "?"
        print(f"  - {title} ({quota} uur) [{slug}]")
PY

  rm -f "$tmp"
}

cmd_untrack_time() {
  parse_args "id" "$@"
  : "${ARG_id:?--id verplicht}"

  load_env
  require_auth

  curl -sS -X DELETE "$WBSO_API_BASE_URL/api/v1/compliance/time_entries/$ARG_id" \
    -H "Authorization: Bearer $WBSO_API_KEY"
}

cmd_evidence() {
  parse_args "title description date external-id user-email" "$@"
  : "${ARG_title:?--title verplicht}"
  : "${ARG_description:?--description verplicht}"
  : "${ARG_date:?--date verplicht}"

  load_env
  require_auth

  local body
  body=$(python3 -c '
import json, sys
ev = {
  "title": sys.argv[1],
  "description": sys.argv[2],
  "starts_at": sys.argv[3] + "T09:00:00Z",
  "ends_at": sys.argv[3] + "T17:00:00Z",
  "all_day": True,
  "source": "wbso-skill",
}
if len(sys.argv) > 4 and sys.argv[4]:
    ev["external_id"] = sys.argv[4]
if len(sys.argv) > 5 and sys.argv[5]:
    ev["user"] = sys.argv[5]
print(json.dumps({"evidence": ev}))
' "$ARG_title" "$ARG_description" "$ARG_date" "${ARG_external_id:-}" "${ARG_user_email:-}")

  curl -sS -X POST "$WBSO_API_BASE_URL/api/v1/compliance/evidence" \
    -H "Authorization: Bearer $WBSO_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$body"
}

main() {
  [ $# -lt 1 ] && usage
  local cmd="$1"; shift
  case "$cmd" in
    signup) cmd_signup "$@" ;;
    login) cmd_login "$@" ;;
    context) cmd_context "$@" ;;
    track-time) cmd_track_time "$@" ;;
    untrack-time) cmd_untrack_time "$@" ;;
    evidence) cmd_evidence "$@" ;;
    whoami) cmd_whoami "$@" ;;
    -h|--help|help) usage ;;
    *) echo "error: onbekend command '$cmd'" >&2; usage ;;
  esac
}

main "$@"
