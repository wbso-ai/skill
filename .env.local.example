# Optionele dev-overrides. Kopieer naar `~/.config/wbso/.env.local`:
#
#   mkdir -p ~/.config/wbso
#   cp .env.local.example ~/.config/wbso/.env.local
#
# SKILL.md sourcet die file automatisch (zie Stap 0) als hij bestaat.
# Andere users die de plugin via de marketplace installeren krijgen
# 'm niet, dus dit blijft een dev-only override.
#
# Praktisch nut: tegen je lokale server testen i.p.v. productie.

WBSO_API_BASE_URL=http://localhost:3000
